# Local app configuration. Copy to .env.local.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Configure the following on your Convex DEVELOPMENT deployment with `convex env set`.
# These secrets never belong in a VITE_ variable.
# SITE_URL=http://localhost:3000
# AUTH_TRUSTED_ORIGINS=http://localhost:3001
# Optional comma-separated extra browser origins, including SSH tunnel ports.
# BETTER_AUTH_SECRET=<random secret, at least 32 characters>
# RESEND_API_KEY=<Resend API key>
# RESEND_FROM=Budget Together <budget@your-verified-domain.com>

# Plaid Sandbox. Set these values on your Convex DEVELOPMENT deployment too.
# Values in .env.local do not configure the Convex backend.
# Plaid client ID and Sandbox secret.
PLAID_CLIENT_ID=
PLAID_SECRET=
# Base64 encoding of 32 random bytes. Generate with: openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=
# Optional approved OAuth redirect URL. Leave blank if not used.
PLAID_REDIRECT_URI=

# TypeSafe Jev transaction classification. Set on the Convex DEVELOPMENT deployment.
# The model is pinned to jev-1.14.0 in convex/jevClient.ts.
JEV_SECRET=

# Historical stock, ETF, and public mutual-fund prices. Set on Convex DEVELOPMENT.
# The backend uses Tiingo monthly split/dividend-adjusted history.
TIINGO_API_TOKEN=
